# Defaults to the live deployment (see README's "Live deployment" section).
# Replace with your own address after `genlayer deploy` if you deploy a fresh instance.
#
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle at BUILD
# time — they must be set in the Vercel project (Production + Preview) and the
# project rebuilt for a change to take effect.
#
# NEXT_PUBLIC_GENLAYER_CHAIN selects the GenLayer network. "studionet" is
# chain id 61999; the app derives the chain id, RPC URL and the wallet
# add/switch parameters from this single value, and refuses to send a
# transaction while the wallet is on any other chain.
NEXT_PUBLIC_GENLAYER_CHAIN=studionet
NEXT_PUBLIC_COURTFLOW_ADDRESS=0xAC2F534da76dFe59e3dBbCB3F822E414E3fd81dE
